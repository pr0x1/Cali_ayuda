# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (optional for v0.1)
AI_GATEWAY_API_KEY=

# App
APP_BASE_URL=http://localhost:3000

# xAI (Grok) — News feed via x_search
XAI_API_KEY=
NEWS_REFRESH_INTERVAL_MS=900000

# Cron Jobs
CRON_SECRET=your-secret-here

# Google Sheets ingest (server-only — never NEXT_PUBLIC, never logged)
# GOOGLE_SERVICE_ACCOUNT_KEY: full service-account JSON (single line).
# The service account email must be shared as Editor on the sheet for write-back.
GOOGLE_SERVICE_ACCOUNT_KEY=
GSHEET_SPREADSHEET_ID=
GSHEET_GID=0
GSHEET_TAB_NAME=Sheet1
